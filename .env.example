# Создайте токен на https://huggingface.co/settings/tokens
# Нужен доступ Inference Providers. Не публикуйте этот файл и не отправляйте токен в браузер.
HF_TOKEN=hf_вставьте_свой_токен_сюда

# Документация Hugging Face указывает fal-ai как пример провайдера для video generation.
VIDEO_PROVIDER=fal-ai
TEXT_VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B
IMAGE_VIDEO_MODEL=Wan-AI/Wan2.2-I2V-A14B

MAX_UPLOAD_MB=10
# После публикации поменяйте на домен фронтенда:
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000
